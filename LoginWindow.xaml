<Window x:Class="HopeFileLocker.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HopeFileLocker" Height="520" Width="400" Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F4F6FB">
        <Border Width="340" Height="430" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="16" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#0F1419" Opacity="0.10"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#014DB2" Offset="0"/>
                            <GradientStop Color="#001645" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M12 2C9.243 2 7 4.243 7 7v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7c0-2.757-2.243-5-5-5zm0 2c1.654 0 3 1.346 3 3v3H9V7c0-1.654 1.346-3 3-3z"
                          Fill="White" Width="30" Height="30" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="HopeFileLocker" FontSize="22" FontWeight="Bold" Foreground="#0F1B2D"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="文件隐私保护工具" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <TextBlock Text="密码" FontSize="13" Foreground="#6B7280" Margin="0,24,0,6"/>
                <PasswordBox x:Name="PwdBox" FontSize="14" Padding="10"
                             BorderBrush="#E6E9EF" BorderThickness="1" Background="#F4F6FB"/>
                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <Button Content="登 录" Click="Login_Click" Margin="0,14,0,0"
                        Background="#1A5FD0" Foreground="White" FontSize="15" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Height="44">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="ForgotBtn" Content="忘记密码？" Click="Forgot_Click" Margin="0,10,0,0"
                        Background="Transparent" Foreground="#1A5FD0" FontSize="12"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>

                <TextBlock x:Name="HintText" FontSize="12" Foreground="#9AA3AF" HorizontalAlignment="Center"
                           Margin="0,16,0,0" TextWrapping="Wrap" Text="请输入登录密码。"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
