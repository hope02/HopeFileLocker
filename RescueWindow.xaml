<Window x:Class="HopeFileLocker.RescueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="找回密码" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#F4F6FB">
        <Border Background="White" CornerRadius="12" Padding="24" Margin="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Color="#0F1419" Opacity="0.10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="找回登录密码" FontSize="16" FontWeight="Bold" Foreground="#0F1B2D"/>

                <!-- 方式一：救援码 -->
                <TextBlock Text="方式一：输入救援码" FontSize="13" FontWeight="SemiBold"
                           Foreground="#0F1B2D" Margin="0,14,0,6"/>
                <TextBox x:Name="CodeBox" FontSize="14" Padding="10" BorderBrush="#E6E9EF"
                         BorderThickness="1" Background="#F4F6FB" CharacterCasing="Upper"
                         PreviewKeyDown="CodeBox_KeyDown"/>
                <Button x:Name="RescueOkBtn" Content="用救援码找回" Width="120" Height="36"
                        Margin="0,10,0,0" Click="RescueOk_Click" HorizontalAlignment="Left"
                        Background="#1A5FD0" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" Margin="0,14,0,0"
                           TextWrapping="Wrap"/>

                <Button Content="取消" Width="80" Height="34" Margin="0,12,0,0"
                        HorizontalAlignment="Right" Click="Cancel_Click"
                        Background="White" Foreground="#1A5FD0" BorderBrush="#C9D5EC"
                        BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
